MUSPARQL_DATABASE_PATH=/srv/musparql/database/musparql.sqlite3
MUSPARQL_APP_SECRET_PATH=/etc/musparql/app-secret
MUSPARQL_OWNER_REVIEWER_ID=reviewer-0001
MUSPARQL_TRUSTED_HOSTS=musparql.industrycommons.net
MUSPARQL_BEHIND_SINGLE_PROXY=1
MUSPARQL_EXPERTISE_SUGGESTIONS_PATH=/opt/musparql/current/catalog/expertise_domain_suggestions.yaml
MUSPARQL_LANGUAGE_OPTIONS_PATH=/opt/musparql/current/catalog/language_options.json
MUSPARQL_ASSIGNMENT_BUNDLE_ROOT=/srv/musparql/review/bundles
MUSPARQL_REVIEW_WORKBENCH_ROOT=/opt/musparql/current/review
MUSPARQL_LINGUISTIC_WORKBENCH_ROOT=/opt/musparql/current/review/linguistic
MUSPARQL_SUBMISSION_ROOT=/srv/musparql/review/submissions
MUSPARQL_CANDIDATE_ROOT=/srv/musparql/review/candidates
MUSPARQL_REVIEW_EXPORT_SCHEMA_PATH=/opt/musparql/current/schemas/review_export.schema.json
MUSPARQL_LINGUISTIC_EXPORT_SCHEMA_PATH=/opt/musparql/current/schemas/linguistic_annotation_export.schema.json
MUSPARQL_PRIVACY_NOTICE_VERSION=
MUSPARQL_CONSENT_STATEMENT_VERSION=
MUSPARQL_PRIVACY_NOTICE_PATH=/etc/musparql/participant-notice.txt
MUSPARQL_CONSENT_SUMMARY_PATH=/etc/musparql/consent-summary.txt
MUSPARQL_CONSENT_STATEMENT_PATH=/etc/musparql/consent-statement.txt
MUSPARQL_ALLOW_SYNTHETIC_PRIVACY_NOTICE=0
MUSPARQL_ALLOW_SYNTHETIC_EMAIL=0
