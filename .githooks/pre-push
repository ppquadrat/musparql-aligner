#!/bin/sh
set -eu
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  python3 scripts/check_public_tree.py --rev "$local_sha"
  revisions=$(git rev-list "$local_sha" --not --remotes)
  for revision in $revisions; do
    [ "$revision" = "$local_sha" ] && continue
    python3 scripts/check_public_tree.py --rev "$revision"
  done
done
