{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/musparql/schemas/reviewer_profile_v2.schema.json",
  "title": "MuSPARQL confidential reviewer profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "name", "affiliation", "email", "domain_expertise",
    "kg_ontology_experience", "sparql_experience", "nlp_llm_experience",
    "language_expertise", "privacy_notice_version",
    "privacy_notice_acknowledged_at"
  ],
  "properties": {
    "schema": {"const": "musparql.reviewer-profile.v2"},
    "id": {"type": "string", "pattern": "^reviewer-[0-9]{4,}$"},
    "name": {"type": "string", "minLength": 1},
    "affiliation": {"type": "string"},
    "email": {"type": "string", "format": "email"},
    "domain_expertise": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/domain_projection"}
    },
    "kg_ontology_experience": {"$ref": "#/$defs/technical_experience"},
    "sparql_experience": {"$ref": "#/$defs/technical_experience"},
    "nlp_llm_experience": {"$ref": "#/$defs/technical_experience"},
    "language_expertise": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
      "additionalProperties": {
        "type": "string",
        "enum": ["basic", "advanced", "fluent", "native"]
      }
    },
    "privacy_notice_version": {"type": "string", "minLength": 1},
    "privacy_notice_acknowledged_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "technical_experience": {
      "type": "string",
      "enum": ["none", "occasional", "regular", "expert"]
    },
    "subject_expertise": {
      "type": "string",
      "enum": ["none", "basic", "working", "advanced", "expert"]
    },
    "nullable_nonempty_string": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "domain_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id", "assertion_id", "entered_label", "normalized_label", "vocabulary_name",
        "vocabulary_concept_uri", "vocabulary_version", "expertise_level",
        "first_asserted_at", "updated_at"
      ],
      "properties": {
        "domain_id": {"type": "string", "minLength": 1},
        "assertion_id": {"type": "string", "minLength": 1},
        "entered_label": {"type": "string", "minLength": 1},
        "normalized_label": {"type": "string", "minLength": 1},
        "vocabulary_name": {"$ref": "#/$defs/nullable_nonempty_string"},
        "vocabulary_concept_uri": {
          "type": ["string", "null"],
          "format": "uri",
          "minLength": 1
        },
        "vocabulary_version": {"$ref": "#/$defs/nullable_nonempty_string"},
        "expertise_level": {"$ref": "#/$defs/subject_expertise"},
        "first_asserted_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"vocabulary_name": {"type": "null"}}},
          "then": {
            "properties": {
              "vocabulary_concept_uri": {"type": "null"},
              "vocabulary_version": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "vocabulary_concept_uri": {"type": "string", "format": "uri", "minLength": 1},
              "vocabulary_version": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
