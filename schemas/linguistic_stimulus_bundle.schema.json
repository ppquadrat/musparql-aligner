{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/musparql/schemas/linguistic_stimulus_bundle.schema.json",
  "title": "Musparql Phase 6b linguistic stimulus bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "task_design_version", "dataset_id", "holdout_input_policy", "randomization", "sampling", "record_count", "records"],
  "properties": {
    "schema": {"const": "musparql.linguistic-stimulus-bundle.v1"},
    "mode": {"const": "linguistic"},
    "task_design_version": {"const": "phase-6b-v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "holdout_input_policy": {"enum": ["no_holdout", "identity_visible_selectors", "identity_private_filtered_upstream"]},
    "randomization": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "seed"],
      "properties": {"algorithm": {"const": "python-mt19937-v1"}, "seed": {"type": "string", "minLength": 1}}
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["target_trials", "available_trials", "strata"],
      "properties": {
        "target_trials": {"type": "integer", "minimum": 1},
        "available_trials": {"type": "integer", "minimum": 1},
        "strata": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "record_count": {"type": "integer", "minimum": 1},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stimulus"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "formulation": {
      "type": "object", "additionalProperties": true,
      "required": ["formulation_id", "version", "text", "digest"],
      "properties": {
        "formulation_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "stimulus": {
      "type": "object", "additionalProperties": false,
      "required": ["trial_id", "kg_id", "query_id", "query_label", "sparql", "sparql_version", "sparql_digest", "literal", "candidates", "eligible", "non_holdout", "presentation_arity", "sampling_stratum", "contrast_id"],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1}, "kg_id": {"type": "string", "minLength": 1},
        "query_id": {"type": "string", "minLength": 1}, "query_label": {"type": "string", "minLength": 1},
        "sparql": {"type": "string", "minLength": 1}, "sparql_version": {"type": "string", "minLength": 1},
        "sparql_digest": {"$ref": "#/$defs/digest"},
        "literal": {"allOf": [{"$ref": "#/$defs/formulation"}, {"type": "object", "required": ["validated", "validation_provenance"], "properties": {"validated": {"const": true}, "validation_provenance": {"type": "object"}}}]},
        "candidates": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"allOf": [{"$ref": "#/$defs/formulation"}, {"type": "object", "required": ["provenance"], "properties": {"provenance": {"type": "object"}}}]}},
        "eligible": {"const": true}, "non_holdout": {"const": true}, "presentation_arity": {"const": 3},
        "sampling_stratum": {"type": "string", "minLength": 1}, "contrast_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
