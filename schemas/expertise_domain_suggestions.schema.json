{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/musparql/schemas/expertise_domain_suggestions.schema.json",
  "title": "MuSPARQL versioned local expertise-domain suggestion set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot_id", "created_on", "sources", "suggestions"],
  "properties": {
    "schema": {"const": "musparql.expertise-domain-suggestions.v1"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "created_on": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "title", "source_version", "usage"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["owner_reviewed_project_terms", "external_vocabulary"]},
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "source_version": {"type": ["string", "null"], "minLength": 1},
          "usage": {"enum": ["suggestion_entries", "reference_only"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suggestion_id", "preferred_label", "alternative_labels", "language",
          "broader_suggestion_ids", "source_id"
        ],
        "dependentRequired": {
          "vocabulary_concept_uri": ["vocabulary_version"],
          "vocabulary_version": ["vocabulary_concept_uri"]
        },
        "properties": {
          "suggestion_id": {"type": "string", "minLength": 1},
          "preferred_label": {"type": "string", "minLength": 1},
          "alternative_labels": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
          "broader_suggestion_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_id": {"type": "string", "minLength": 1},
          "vocabulary_concept_uri": {"type": "string", "format": "uri"},
          "vocabulary_version": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
